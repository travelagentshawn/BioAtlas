{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/travelagentshawn/BioAtlas/schema/region.schema.json",
  "title": "Region / travel scene (the bridge to the travel workbench)",
  "description": "A place or typical travel scene and which species a traveller can expect there, by month. Species do not repeat this information; the build derives the reverse index.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "const": "region"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "kind": {
      "type": "string",
      "enum": [
        "destination",
        "scene"
      ],
      "description": "destination = tied to coordinates; scene = a recurring kind of place (e.g. temple gardens) not tied to one location."
    },
    "names": {
      "$ref": "common.schema.json#/$defs/i18n"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/i18n"
    },
    "countries": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/country"
      },
      "minItems": 1
    },
    "center": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "lat",
        "lng"
      ],
      "additionalProperties": false
    },
    "radius_km": {
      "type": "number",
      "minimum": 1
    },
    "habitats": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/habitat"
      }
    },
    "species": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "species": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "months": {
            "$ref": "common.schema.json#/$defs/months"
          },
          "likelihood": {
            "type": "string",
            "enum": [
              "common",
              "regular",
              "uncommon",
              "rare"
            ]
          },
          "note": {
            "$ref": "common.schema.json#/$defs/i18n"
          },
          "evidence": {
            "type": "array",
            "description": "Evidence for this specific species-in-region association and its month range. Empty or absent means the association has not been source-verified.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "field-observation",
                    "published-literature",
                    "regional-checklist",
                    "database-record",
                    "expert-assessment"
                  ]
                },
                "source": {
                  "$ref": "common.schema.json#/$defs/slug"
                },
                "note": {
                  "$ref": "common.schema.json#/$defs/i18n"
                }
              },
              "required": [
                "type",
                "source"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          }
        },
        "required": [
          "species",
          "months",
          "likelihood"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/source_refs"
    },
    "review_status": {
      "$ref": "common.schema.json#/$defs/review_status"
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    }
  },
  "required": [
    "type",
    "id",
    "kind",
    "names",
    "description",
    "countries",
    "species",
    "review_status"
  ],
  "additionalProperties": false
}
