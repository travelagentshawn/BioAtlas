{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/travelagentshawn/BioAtlas/schema/trip.schema.json",
  "title": "BioAtlas trip (interchange format for the travel workbench)",
  "description": "The file the Trip Workbench exports and imports. Any external travel planner can produce this JSON and open it in BioAtlas (Workbench → Import). It references regions by id; destinations with coordinates let BioAtlas find nearby regions.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "type": { "const": "bioatlas-trip" },
    "format_version": { "const": 1 },
    "name": { "type": "string" },
    "month": { "type": ["integer", "null"], "minimum": 1, "maximum": 12 },
    "regions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true },
    "destinations": {
      "type": "array",
      "description": "Optional places from the external planner. BioAtlas matches regions whose centre lies within radius_km (+ the region's own radius).",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lng": { "type": "number", "minimum": -180, "maximum": 180 },
          "radius_km": { "type": "number", "minimum": 1 },
          "date_from": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "date_to": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        },
        "required": ["lat", "lng"],
        "additionalProperties": false
      }
    },
    "checked": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true, "description": "Species ids already ticked off." },
    "exported_at": { "type": "string" }
  },
  "required": ["type", "format_version", "regions"],
  "additionalProperties": false
}
